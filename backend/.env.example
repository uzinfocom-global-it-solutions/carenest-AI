# Per-developer secrets. Copy to `.env` and fill in real values. Gitignored.
# Each key follows .NET configuration section conventions: use `__` as the
# section separator (`LLM__BaseUrl` becomes the `LLM:BaseUrl` setting and
# overrides whatever is in appsettings.json).

# LLM (vLLM, OpenAI-compatible chat completions)
LLM__BaseUrl=https://your-vllm-host/v1/
LLM__Token=REPLACE_WITH_LLM_TOKEN
LLM__Model=google/gemma-4-31B-it
LLM__Temperature=0.3

# Postgres / Redis (override if your local instance differs from docker-compose)
# ConnectionStrings__BackendDb=Host=localhost;Port=5432;Database=carenestai;Username=carenestai;Password=carenestai_dev_pass
# ConnectionStrings__Redis=localhost:6379

# JWT (set a real secret in production)
# Jwt__SecretKey=replace-me-with-a-32-char-or-longer-secret
